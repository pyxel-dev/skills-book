{
  "name": "skills-book",
  "productName": "Skills Book",
  "version": "0.1.0",
  "description": "Liste et édite les skills (SKILL.md) présentes sur la machine",
  "main": "src/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyxel-dev/skills-book.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "dev.pyxel.skills-book",
    "productName": "Skills Book",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "easymde": "^2.21.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
